# Font settings
# Previous font: "JetBrainsMono Nerd Font"
font-family = "IoskeleyMonoTerm Nerd Font"
font-size = 16

# Background settings
# Tokyo Night's default background was #1a1b26.
# Pure black test. Keep this after the theme so it overrides Tokyo Night.
# background = #1a1b26
# background-blur-radius = 0

# Theme
theme = "tokyonight"
background = #000000

# Keybindings
# Previous Shift+Enter override. Disabled so TUIs like pi can receive Shift+Enter
# and use it for multiline input. (Seems to work now in tools like claude code/codex)
# keybind = shift+enter=text:\x1b\r

# Keyboard
# Make the LEFT Option key send Alt/Meta so Option+arrow, Option+B/F and
# Option+Backspace reach the shell as real word-motion keys. The RIGHT Option
# key is left alone so it can still type composed characters (é, –, etc.).
macos-option-as-alt = left
